### Admin login
POST {{url}}/auth/login
Content-Type: application/json

{
    "email": "sheilla@gmail.com",
    "password": "Pass123"
}

### Create admin user
POST {{url}}/users
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "name": "Sheilla Mungai",
  "email": "sheilla@gmail.com",
  "password": "Pass123",
  "role": "admin",
  "phone": "0710101010"
}

### Create a customer user
POST {{url}}/users
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "name": "Jane Customer",
  "email": "jane@gmail.com",
  "password": "Jane123",
  "role": "customer",
  "phone": "0712345678"
}

### Customer login
POST {{url}}/auth/login
Content-Type: application/json

{
  "email": "jane@gmail.com",
  "password": "Jane123"
}

### Create customer profile for an existing customer user
POST {{url}}/customers
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "user_id": 2,
  "name": "Jane Customer",
  "email": "jane@gmail.com",
  "password": "Jane123",
  "gender": "female",
  "phone": "0712345678",
  "address": "Kilimani, Nairobi"
}

### Apply to become a seller (authenticated customer)
POST {{url}}/sellers/apply
Content-Type: application/json
Authorization: Bearer {{customer_token}}

{
  "gender": "female",
  "address": "Kilimani, Nairobi"
}

### Apply to become a seller (unauthenticated customer)
POST {{url}}/sellers/apply
Content-Type: application/json
Authorization: Bearer {{customer_token}}

{
  "gender": "female",
  "address": "Westlands, Nairobi"
}

### Create a seller user (admin can create a seller account)
POST {{url}}/users
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "name": "Amina Seller",
  "email": "amina.seller@gmail.com",
  "password": "Amina123",
  "role": "seller",
  "phone": "0700112233"
}


### Seller login
POST {{url}}/auth/login
Content-Type: application/json

{
  "email": "amina.seller@gmail.com",
  "password": "Amina123"
}

### Get all customers
GET {{url}}/sellers
Authorization: Bearer {{admin_token}}

### Get one customer
GET {{url}}/customers/1
Authorization: Bearer {{admin_token}}


### 1) Create a customer user
POST {{url}}/users
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "name": "Penny Customer",
  "email": "penny@gmail.com",
  "password": "Penny123",
  "role": "customer",
  "phone": "0712345678"
}


### customer login
POST {{url}}/auth/login
Content-Type: application/json

{
  "email": "penny@gmail.com",
  "password": "Penny123"
}

### 2) Create customer profile
POST {{url}}/customers
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "user_id": 4,
  "name": "Penny Customer",
  "gender": "female",
  "address": "Roysambu, Nairobi"
}

### Create root category (admin)
POST {{url}}/categories
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "category_name": "Clothing",
  "description": "All clothing items",
  "parent_id": 0
}

### Example: create another root category (admin)
POST {{url}}/categories
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "category_name": "Accessories",
  "description": "belts, hats, and other fashion accessories",
  "parent_id": 2
}

### Create sub-category (admin) — parent_id = id returned for Clothing (e.g. 1)
POST {{url}}/categories
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "category_name": "Dresses",
  "description": "Women's dresses",
  "parent_id": 1
}

